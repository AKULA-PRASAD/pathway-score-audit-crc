# --- virtual environment ---
.venv/
venv/
env/

# --- raw data (356 MB; integrity tracked in data/raw/CHECKSUMS.sha256) ---
data/raw/*
!data/raw/CHECKSUMS.sha256
# NOTE: 'data/raw/*' not 'data/raw/' -- git cannot re-include a file
# whose PARENT DIRECTORY is excluded, so the negation above would be
# silently ignored with a trailing-slash pattern.

# --- generated caches (reproducible from raw data) ---
data/processed/

# --- external evidence fetched on demand (public supplementary data) ---
data/external/

# --- python bytecode / build ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- os / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- credentials and secrets (defensive; none currently in project) ---
.env
.env.*
*.pem
*.key
credentials.json
secrets.yaml

# --- Phase 9 corrected checkpoints (>100 MB each at B_out = 750) ---
# Archived outside Git (owner decision B, 8 Nov 2026); every byte is pinned by
# reports/phase9/ARCHIVE_MANIFEST_SHA256.txt. Restore and check: docs/LARGE_ARTIFACT_ARCHIVE.md
reports/phase9/corrected_rerun/runs/*.jsonl
reports/phase9/corrected_rerun/runs/*.lock

# --- editor / OS lock files ---
~$*
.DS_Store
